{
  "name": "riffit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "check:functions": "deno fmt --check --config supabase/functions/deno.json supabase/functions && deno lint --config supabase/functions/deno.json supabase/functions && deno check --config supabase/functions/deno.json supabase/functions",
    "test:functions": "deno test --config supabase/functions/deno.json --allow-read --ignore=supabase/functions/tests/integration supabase/functions/tests",
    "test:functions:integration": "deno test --config supabase/functions/deno.json --allow-read --allow-env --allow-net=127.0.0.1,localhost supabase/functions/tests/integration",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts && prettier --write packages/supabase/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "deno": "2.9.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
