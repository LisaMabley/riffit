# Copy to .env, fill in the values, and restart Expo.
# See "Running the app on a phone" in the README.

# On a phone, localhost means the phone itself. Use your computer's LAN address.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321

# PUBLISHABLE_KEY from `pnpm supabase status`. Never use the secret key: this value ships in the app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
